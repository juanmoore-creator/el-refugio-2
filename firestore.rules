rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para subcolecciones de cada propiedad
    match /properties/{propertyId} {
      allow read: if true;

      match /bookings/{bookingId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /settings/{settingId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Reglas retrocompatibles con colecciones raíz
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
